DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set all POSTGRES_* values to use PostgreSQL. When omitted, local development uses SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PUBLIC_SITE_URL=http://127.0.0.1:3000
WAGTAILADMIN_BASE_URL=http://127.0.0.1:8000
# Optional public origin for Django media when accessed through another host.
PUBLIC_MEDIA_BASE_URL=
