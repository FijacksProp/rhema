DJANGO_SECRET_KEY=replace-me-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Local development uses SQLite by default. DATABASE_URL is preferred for hosted PostgreSQL.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Cloud deployment: preferred single PostgreSQL connection string. Keep secrets in Vercel, not Git.
DATABASE_URL=
PUBLIC_SITE_URL=http://127.0.0.1:3000
WAGTAILADMIN_BASE_URL=http://127.0.0.1:8000
# Optional public origin for Django media when accessed through another host.
PUBLIC_MEDIA_BASE_URL=
# Configure an S3-compatible public media bucket (for example Cloudflare R2) for deployed CMS uploads.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Public host name only, without scheme or trailing slash.
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Comma-separated HTTPS origins, normally unnecessary for the single-domain CMS.
DJANGO_CSRF_TRUSTED_ORIGINS=
